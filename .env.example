PORT=5000

# Gmail account used to send the message
EMAIL_USER=yourgmail@gmail.com

# Gmail App Password, not your normal Gmail password
EMAIL_PASS=your_16_character_gmail_app_password

# The inbox where you want to receive portfolio messages
RECEIVER_EMAIL=yourgmail@gmail.com

# Optional. If frontend and backend are hosted together, keep this as localhost for local testing.
FRONTEND_URL=http://localhost:5000
